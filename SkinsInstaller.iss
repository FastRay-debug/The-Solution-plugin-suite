; The Solution - Skins & Skin Editor (separate installer, Inno Setup 6.3+). GENERATED by packaging/gen_skins.py - edit that, not this.
;
; Expects, next to this file:  The Solution\Skins\*.jpg + skins.json   The Solution\SkinEditor\Skin Editor.exe
; Every skin is its own checkbox (only skins whose photo exists are offered). Skins go to the shared folder every Solution
; plugin reads; the Skin Editor goes where the plugins' "Skin Editor" button looks for it.

#ifndef AppVersion
  #define AppVersion "0.2.0"
#endif
#define Src "The Solution"

[Setup]
AppId={{8C1F3B52-6A2E-4D7B-9E1C-3F4A5B6C7D80}
AppName=The Solution - Skins & Skin Editor
AppVersion={#AppVersion}
AppPublisher=Billet Audio
DefaultDirName={commonpf64}\Billet Audio\The Solution
UninstallDisplayName=The Solution - Skins & Skin Editor
OutputDir=OutputInstaller
OutputBaseFilename=The_Solution_Skins_Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
DisableWelcomePage=yes
DisableDirPage=yes
DisableProgramGroupPage=yes
DisableReadyPage=yes

[Types]
Name: "full";   Description: "Everything"
Name: "custom"; Description: "Choose skins"; Flags: iscustom

[Components]
Name: "editor"; Description: "Skin Editor (make skins from your own photos)"; Types: full custom
Name: "cars"; Description: "Cars"; Types: full custom
Name: "cars\lincoln69"; Description: "'69 Lincoln Continental"; Types: full custom
Name: "cars\camaro71"; Description: "'71 Camaro (Orange)"; Types: full custom
Name: "cars\mach1"; Description: "'70 Mustang Mach 1"; Types: full custom
Name: "cars\eviltwin"; Description: "'68 Evil Twin"; Types: full custom
Name: "cars\eldorado59"; Description: "'59 Cadillac Eldorado"; Types: full custom
Name: "cars\cuda70"; Description: "'70 HEMI 'Cuda"; Types: full custom
Name: "cars\gto67"; Description: "'67 Pontiac GTO"; Types: full custom
Name: "places"; Description: "Places"; Types: full custom
Name: "places\rome"; Description: "Rome Pantheon"; Types: full custom
Name: "places\giza"; Description: "Giza Pyramids"; Types: full custom
Name: "places\aztec"; Description: "Aztec Ruins"; Types: full custom
Name: "places\serengeti"; Description: "Serengeti Falls"; Types: full custom
Name: "places\museum"; Description: "Museum Gallery"; Types: full custom
Name: "places\piano"; Description: "Concert Piano"; Types: full custom

[Files]
Source: "{#Src}\SkinEditor\Skin Editor.exe"; DestDir: "{app}\Skin Editor"; Components: editor; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#Src}\Skins\skins.json"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#Src}\Skins\lincoln69.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\lincoln69; Flags: ignoreversion
Source: "{#Src}\Skins\camaro71.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\camaro71; Flags: ignoreversion
Source: "{#Src}\Skins\mach1.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\mach1; Flags: ignoreversion
Source: "{#Src}\Skins\eviltwin.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\eviltwin; Flags: ignoreversion
Source: "{#Src}\Skins\eldorado59.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\eldorado59; Flags: ignoreversion
Source: "{#Src}\Skins\cuda70.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\cuda70; Flags: ignoreversion
Source: "{#Src}\Skins\gto67.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: cars\gto67; Flags: ignoreversion
Source: "{#Src}\Skins\rome.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\rome; Flags: ignoreversion
Source: "{#Src}\Skins\giza.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\giza; Flags: ignoreversion
Source: "{#Src}\Skins\aztec.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\aztec; Flags: ignoreversion
Source: "{#Src}\Skins\serengeti.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\serengeti; Flags: ignoreversion
Source: "{#Src}\Skins\museum.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\museum; Flags: ignoreversion
Source: "{#Src}\Skins\piano.jpg"; DestDir: "{commonappdata}\Billet Audio\The Solution\Skins"; Components: places\piano; Flags: ignoreversion

[Tasks]
Name: "desktop"; Description: "Skin Editor shortcut on the desktop"; Components: editor

[Icons]
Name: "{commonprograms}\The Solution\Skin Editor"; Filename: "{app}\Skin Editor\Skin Editor.exe"; Components: editor
Name: "{commondesktop}\Skin Editor"; Filename: "{app}\Skin Editor\Skin Editor.exe"; Components: editor; Tasks: desktop

[Run]
Filename: "{app}\Skin Editor\Skin Editor.exe"; Description: "Open the Skin Editor"; Flags: nowait postinstall skipifsilent; Components: editor
